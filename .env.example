# =============================================================================
# Enterprise AI Forecasting & Decision Intelligence Platform
# Copy this file to .env and fill in values. Never commit .env.
# =============================================================================

# --- Application ---
APP_NAME=decision-intelligence-platform
APP_ENV=development
LOG_LEVEL=INFO

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# --- Dashboard (Streamlit) ---
STREAMLIT_PORT=8501

# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=decision-intelligence

# --- Paths (local development) ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models

# --- Azure Blob Storage ---
# Prefer DefaultAzureCredential / managed identity in production.
# Example (after ./scripts/provision_azure_platform.sh):
#   AZURE_STORAGE_ACCOUNT_NAME=stdipxxxxxxxx
#   AZURE_STORAGE_ACCOUNT_URL=https://stdipxxxxxxxx.blob.core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_RAW=raw-datasets
AZURE_STORAGE_CONTAINER_PROCESSED=processed-datasets
# Leave blank if using Azure CLI / managed identity / DefaultAzureCredential
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=

# --- Azure Machine Learning (future training / deployment) ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-decision-intelligence
AZURE_ML_WORKSPACE_NAME=mlw-decision-intelligence
AZURE_ML_WORKSPACE_REGION=eastus

# --- Azure authentication (optional service principal for CI / local) ---
# Prefer `az login` or managed identity over hard-coding these.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Model / inference defaults ---
CHURN_MODEL_URI=models:/churn_classifier/Production
SEGMENTATION_MODEL_PATH=models/segmentation/kmeans.joblib
FORECAST_MODEL_PATH=models/forecasting/pytorch_forecaster.pt
