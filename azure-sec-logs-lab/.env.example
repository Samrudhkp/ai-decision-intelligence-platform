# Azure Event-Driven Security Lab
#
# Blob Storage (logs) → Event Grid → Azure Function (AnalyzeLoginLog) → Blob Storage (reports)
#
# Copy to .env for local tooling only. Never commit real secrets.
# Prefer: az login  OR  service principal env vars injected as Cursor secrets.

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Deployment defaults (override as needed)
AZURE_LOCATION=eastus
RESOURCE_GROUP=rg-sec-logs-lab
STORAGE_ACCOUNT_PREFIX=stseclogs
FUNCTION_APP_PREFIX=fn-seclogs
FUNCTION_NAME=AnalyzeLoginLog
FAILURE_THRESHOLD=5
